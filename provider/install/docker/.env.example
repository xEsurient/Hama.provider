# HAMA provider: Docker settings. Copy to .env next to compose.yml and edit. .env is git-ignored: keep secrets (Plex token) only there.
# Every provider setting is listed below with its default. Lines starting with # use the default - uncomment to change.
# Lists are comma-separated (en,main,ja), switches are true/false. Restart after changes: docker compose up -d --force-recreate
# (config.json in the data folder works too; these HAMA_* variables override it.)

# =====================================================================================================================
# Docker (used by compose.yml)
# =====================================================================================================================
# Image to run. Release images: ghcr.io/xesurient/hama.provider:latest (or a version like :1.2.5).
# Built locally (provider/install/docker/build.sh): hama-provider:local
HAMA_IMAGE=ghcr.io/xesurient/hama.provider:latest

# Container user: owner of your media files (for 'prepare --apply') and of the data folder.
# Create the data folder first:  mkdir -p data && sudo chown 1000:1000 data
PUID=1000
PGID=1000
TZ=UTC

# Host folder for the cache, config.json, anime-list-custom.xml, report/event files
HAMA_DATA_DIR_HOST=./data

# Your anime library, mounted at /media in the container (for 'prepare').
# ro = preview only; rw lets 'prepare --apply' rename files and write .plexmatch
MEDIA_DIR=/path/to/your/anime
MEDIA_MODE=ro

# =====================================================================================================================
# Plex connection (optional): collection sync, re-matching unmatched items, refresh after pre-fetch
# =====================================================================================================================
# Plex address as seen from this container; empty (default) = no Plex connection. (Option B in compose.yml: http://127.0.0.1:32400, no token needed)
# HAMA_PLEX_URL=http://plex:32400
# Token: Plex Web > any item > Get Info > View XML > copy X-Plex-Token from the address bar. Keep it secret.
# HAMA_PLEX_TOKEN=
# Hours between collection syncs (0 = only by hand: python -m hama_provider --sync-collections)
# HAMA_COLLECTION_SYNC_HOURS=12
# Only create a collection when at least this many of its items are in the library
# HAMA_COLLECTION_MIN_ITEMS=2
# Work out franchise / TMDB collections at all
# HAMA_COLLECTIONS=true
# Re-match items Plex left unmatched (e.g. scanned while the provider was down); 2 min after start, then every 6 h
# HAMA_RESCUE_UNMATCHED=true

# =====================================================================================================================
# Titles and languages
# =====================================================================================================================
# Show title language order. main = AniDB's main title (usually romaji), en/ja/de/… = official titles in that language.
# English names first:  en,main,ja
# HAMA_SERIES_LANGUAGE_PRIORITY=main,en,ja
# Episode title language order
# HAMA_EPISODE_LANGUAGE_PRIORITY=main,en,ja
# Put the Plex library's language first in both lists above
# HAMA_USE_REQUEST_LANGUAGE=false
# Language of Plex's "Original Title" field
# HAMA_ORIGINAL_TITLE_LANGUAGE=ja
# Non-English libraries: show and episode summaries from TheMovieDb in the library language
# HAMA_LOCALIZE_SUMMARIES=true

# =====================================================================================================================
# Artwork, themes, ratings
# =====================================================================================================================
# Source order (first = preferred). Sources: AniList, AniDB, TheTVDB, FanartTV, TheMovieDb. Remove one to disable it.
# HAMA_POSTER_SOURCES=AniList,AniDB,TheTVDB,FanartTV,TheMovieDb
# HAMA_BACKGROUND_SOURCES=FanartTV,TheTVDB,TheMovieDb
# Season posters (TVDB-seasons provider)
# HAMA_SEASON_POSTER_SOURCES=AniList,AniDB,TheTVDB,FanartTV
# Title logos (clearLogo)
# HAMA_LOGO_SOURCES=FanartTV,TheMovieDb
# Logo language order (the library language is always tried first); the empty last entry = textless logos
# HAMA_LOGO_LANGUAGE_PRIORITY=en,ja,
# How many choices per image type Plex gets (poster picker)
# HAMA_MAX_IMAGES_PER_TYPE=10
# Theme songs from Plex's TV theme library
# HAMA_THEME_SONGS=true
# TMDB audience rating (AniDB/MAL scores can't be shown: Plex has no badge for them)
# HAMA_TMDB_RATING=true

# =====================================================================================================================
# Matching
# =====================================================================================================================
# Lowest title-search score (0-100) accepted for automatic matches
# HAMA_MATCH_MIN_SCORE=50
# Genres: also use AniDB tags at or above the minimum weight (not only the main "infobox" tags)
# HAMA_GENRES_ADD_WEIGHTS=false
# HAMA_GENRE_MINIMUM_WEIGHT=400

# =====================================================================================================================
# AniDB and API keys (HAMA's shared keys are the defaults)
# =====================================================================================================================
# AniDB HTTP client name/version (HAMA's by default; register your own on anidb.net > Settings > Client if you like)
# HAMA_ANIDB_CLIENT=hama
# HAMA_ANIDB_CLIENTVER=1
# AniDB title list: mirror = Anime-Lists GitHub copy with AniDB fallback (recommended); anidb = AniDB only (max once a day)
# HAMA_ANIDB_TITLES_SOURCE=mirror
# Seconds between background AniDB fetches for long franchises (0 = off). Lower = faster, but higher AniDB ban risk.
# HAMA_ANIDB_PREFETCH_SECONDS=30
# Your own keys avoid shared rate limits. fanart.tv: a free personal key is enough.
# HAMA_FANART_API_KEY=
# HAMA_TMDB_API_KEY=
# HAMA_TVDB_API_KEY=

# =====================================================================================================================
# Profiles: extra provider URLs with their own settings (one line of JSON). Add http://<host>:32550/<name> in Plex.
# base = tv, tvdb or movies. Allowed settings: the title, artwork, theme/rating, collections, genre and match_min_score ones.
# =====================================================================================================================
# HAMA_PROFILES={"tv-en": {"base": "tv", "title": "HAMA – Anime (English titles)", "series_language_priority": ["en", "main"], "episode_language_priority": ["en", "main"]}}

# =====================================================================================================================
# Maintenance and logging
# =====================================================================================================================
# Delete cached API answers not refreshed for this many days (AniDB and TheTVDB data is always kept)
# HAMA_CACHE_MAX_AGE_DAYS=90
# DEBUG, INFO, WARNING or ERROR (docker compose logs shows it)
# HAMA_LOG_LEVEL=INFO
# Also write the log to a file (path inside the container, e.g. /data/hama.log)
# HAMA_LOG_FILE=

# =====================================================================================================================
# Advanced: leave these alone in Docker unless you know why
# =====================================================================================================================
# Listen address/port inside the container. The image sets HAMA_HOST=0.0.0.0. If you change the port, also change
# "ports:" in compose.yml (the healthcheck follows HAMA_PORT automatically).
# HAMA_HOST=0.0.0.0
# HAMA_PORT=32550
# Data folder inside the container (the image uses /data, mounted from HAMA_DATA_DIR_HOST)
# HAMA_DATA_DIR=/data
# Path of a config.json to use instead of <data folder>/config.json
# HAMA_CONFIG=
# Paging start index Plex uses (0 for PMS 1.43+)
# HAMA_CONTAINER_START_BASE=0
# Research: advertise a 'markers' feature and record Plex's requests on /report (Plex Pass servers)
# HAMA_EXPERIMENTAL_MARKERS=false
