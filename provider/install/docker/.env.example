# Copy to .env next to compose.yml and fill in what you need. .env is git-ignored: keep secrets (Plex token) only there.
# Every provider setting can be set as HAMA_<NAME> (see config.example.json).

# Image to run. Release images: ghcr.io/<github-owner>/<repo>:latest (or a version like :1.2.0).
# Built locally with build.sh: hama-provider:local
HAMA_IMAGE=ghcr.io/<github-owner>/<repo>:latest

# Container user: the owner of your media files (for 'prepare --apply') and of the data folder.
# Create the data folder first:  mkdir -p data && sudo chown 1000:1000 data
PUID=1000
PGID=1000
TZ=UTC

# Host folder for the cache, config.json and anime-list-custom.xml
HAMA_DATA_DIR_HOST=./data

# Your anime library, mounted at /media in the container (for 'prepare').
# MEDIA_MODE=ro only previews; rw lets 'prepare --apply' rename files and write .plexmatch.
MEDIA_DIR=/path/to/your/anime
MEDIA_MODE=ro

# Collection sync and Plex refresh after pre-fetch (optional).
# Token: Plex Web > any item > Get Info > View XML > copy X-Plex-Token from the address bar.
# HAMA_PLEX_URL=http://plex:32400
# HAMA_PLEX_TOKEN=

# Optional: your own AniDB HTTP client instead of HAMA's (anidb.net > Settings > Client)
# HAMA_ANIDB_CLIENT=
# HAMA_ANIDB_CLIENTVER=1

# Your own API keys (optional; HAMA's shared keys are the defaults). fanart.tv: a free personal key is enough.
# HAMA_FANART_API_KEY=
# HAMA_TMDB_API_KEY=

# Extra provider with its own settings, e.g. English titles first -> add http://<host>:32550/tv-en in Plex
# HAMA_PROFILES={"tv-en": {"base": "tv", "title": "HAMA – Anime (English titles)", "series_language_priority": ["en", "main"]}}
